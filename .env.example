# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올라가지 않습니다)

# Stockfish 실행 파일 경로. 비워두면 PATH, /usr/games/stockfish 등에서 자동으로 찾습니다.
# 예: /usr/games/stockfish  또는  /home/me/stockfish/stockfish-ubuntu-x86-64-avx2
STOCKFISH_PATH=

# Ollama에서 사용할 모델 / 서버 주소
CHESS_COACH_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# chess.com API는 User-Agent에 연락처를 넣는 것을 권장합니다 (이메일 등)
CHESSCOM_CONTACT=

# 내 책/노트 지식 베이스 폴더 (기본: 현재 폴더의 knowledge/)
CHESS_COACH_KB_DIR=
